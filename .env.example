# Puerto HTTP del servicio
PORT=3000

# Dominio público con el que se construyen los links devueltos.
# Si se deja vacío, se usa el host de la petición entrante.
PUBLIC_BASE_URL=https://mp3.midominio.com

# Carpeta donde se guardan los MP3
STORAGE_DIR=./storage

# Horas de vida de cada MP3 antes de borrarse automáticamente (0 = nunca)
FILE_TTL_HOURS=24

# Conversiones simultáneas máximas
MAX_CONCURRENT=2

# Duración máxima del video en segundos (0 = sin límite). 5400 = 90 min
MAX_DURATION_SECONDS=5400

# Bitrate del MP3: 128K, 192K, 320K...
AUDIO_BITRATE=192K

# Si se define, /api/* exige el header  x-api-key: <valor>
API_KEY=

# Ruta a un cookies.txt de yt-dlp (opcional, ayuda contra bloqueos anti-bot de YouTube)
YTDLP_COOKIES=
